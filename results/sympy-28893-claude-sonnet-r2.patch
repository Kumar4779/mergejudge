@@ -1212,6 +1212,13 @@ def as_real_imag(self, deep=True, **hints):
 
     def _eval_derivative(self, s):
         from sympy.functions.elementary.exponential import log
+        if not self.base.is_commutative and self.exp.is_Integer and self.exp > 0 \
+                and not self.exp.has(s):
+            from sympy.core.add import Add
+            b = self.base
+            n = int(self.exp)
+            db = b.diff(s)
+            return Add(*[b**k * db * b**(n - 1 - k) for k in range(n)])
         dbase = self.base.diff(s)
         dexp = self.exp.diff(s)
         return self * (dexp * log(self.base) + dbase * self.exp/self.base)
