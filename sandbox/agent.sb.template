;; MergeJudge agent sandbox (sandbox-exec / SBPL). The runner fills the
;; placeholders per run with real (symlink-resolved) paths:
;;   {WORKTREE} the agent's temp worktree   {PROJECT} the MergeJudge root
;;   {TMPDIR}   the system temp dir         {HOME}    the user's home
;;   {PROXY_PORT} the runner's egress proxy (src/egress_proxy.py)
(version 1)
(allow default)

;; No network, except the local egress proxy, which forwards only to the
;; model API.
(deny network*)
(allow network-outbound (remote ip "localhost:{PROXY_PORT}"))

;; Nothing in the project is readable: task and gold patches, results,
;; the README's write-ups, the task clones' history. The one exception is
;; envs/, the task Pythons the agent runs tests with. Later rules win, so
;; the envs allow must stay after the project deny.
(deny file-read* (subpath "{PROJECT}"))
(allow file-read* (subpath "{PROJECT}/envs"))
;; realpath() of the env Python stats each ancestor directory; allow stat
;; (not listing, not reading) of the project root itself.
(allow file-read-metadata (literal "{PROJECT}"))

;; Writes only to the worktree, temp, and Claude's own state.
(deny file-write*
    (require-not
        (require-any
            (subpath "{WORKTREE}")
            (subpath "{TMPDIR}")
            (subpath "/private/tmp")
            (subpath "{HOME}/.claude")
            (subpath "/dev"))))
